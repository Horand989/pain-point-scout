# ─────────────────────────────────────────────────────────────
# Pain Point Scout — API credentials.  Copy this file to ".env"
# and fill in your real keys.  NEVER commit the real .env.
# Each source is OPTIONAL — a missing key just skips that source
# (logged, not crashed), so you can turn them on one at a time.
# ─────────────────────────────────────────────────────────────

# 1) REDDIT — official API (free). Create a "script" app at:
#    https://www.reddit.com/prefs/apps  → create app → type: script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pain-point-scout/0.1 by u/YOUR_REDDIT_USERNAME

# 2) GOOGLE — Custom Search JSON API (free 100 queries/day).
#    API key: https://developers.google.com/custom-search/v1/introduction
#    Search-engine ID (cx): https://programmablesearchengine.google.com/  (set it to "search the entire web")
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 3) PERPLEXITY — sonar API. (You already have this key in ValidatePulse.)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# 4) OPENAI — used only to draft the Type A replies (responder.py).
OPENAI_API_KEY=
RESPONDER_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# BRIDGE TO VETO+ (optional) — push build-signals into Veto+'s
# database as pending ideas (appear in its saved-ideas list).
# Writes ONLY to research_sessions; changes nothing in Veto+ code.
# Only runs when main.py is called with --push-to-veto.
# These come from Veto+'s own .env.local.
# ─────────────────────────────────────────────────────────────
VETO_SUPABASE_URL=
VETO_SUPABASE_SERVICE_ROLE_KEY=
VETO_USER_ID=
