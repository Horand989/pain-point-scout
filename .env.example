# ─────────────────────────────────────────────────────────────
# Pain Point Scout — API credentials.  Copy this file to ".env"
# and fill in your real keys.  NEVER commit the real .env.
# Each source is OPTIONAL — a missing key just skips that source
# (logged, not crashed), so you can turn them on one at a time.
# ─────────────────────────────────────────────────────────────

# 1) REDDIT — official API (free). Create a "script" app at:
#    https://www.reddit.com/prefs/apps  → create app → type: script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pain-point-scout/0.1 by u/YOUR_REDDIT_USERNAME

# 2) GOOGLE — Custom Search JSON API (free 100 queries/day).
#    API key: https://developers.google.com/custom-search/v1/introduction
#    Search-engine ID (cx): https://programmablesearchengine.google.com/  (set it to "search the entire web")
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 3) PERPLEXITY — sonar API. (You already have this key in ValidatePulse.)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# 4) OPENAI — used only to draft the Type A replies (responder.py).
OPENAI_API_KEY=
RESPONDER_MODEL=gpt-4o-mini

# 5) SCRAPINGBEE — FALLBACK scraper for Reddit + Google. The free official
#    APIs above are PRIMARY; ScrapingBee only kicks in when Reddit has no key
#    yet or Google CSE is 403. Get the key at https://app.scrapingbee.com/
#    (Account → API key). This guarantees Reddit/Google never come back empty.
SCRAPINGBEE_API_KEY=

# ─────────────────────────────────────────────────────────────
# BRIDGE TO VETO+ (optional) — push build-signals into Veto+'s
# database as pending ideas (appear in its saved-ideas list).
# Writes ONLY to research_sessions; changes nothing in Veto+ code.
# Only runs when main.py is called with --push-to-veto.
# These come from Veto+'s own .env.local.
# ─────────────────────────────────────────────────────────────
VETO_SUPABASE_URL=
VETO_SUPABASE_SERVICE_ROLE_KEY=
VETO_USER_ID=

# ─────────────────────────────────────────────────────────────
# DELIVERY (optional) — how the daily digest reaches you.
# Runs only when main.py is called with --notify.
# ─────────────────────────────────────────────────────────────

# Telegram: message @BotFather → /newbot → copy the token here.
# Then message your new bot once, and get your chat id from
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates (look for "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP. For Gmail: turn on 2-step verification, then create an
# "App Password" (Google Account → Security → App passwords) and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=your_gmail_address@gmail.com
